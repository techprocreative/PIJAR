# PIJAR API — environment
# Salin ke .env dan sesuaikan.

# PostgreSQL
DATABASE_URL=postgresql://pijar:pijar@localhost:5433/pijar?schema=public

# JWT (WAJIB di production — access 15m, refresh 30d, rotasi di server)
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
OTP_HASH_SECRET=ganti-dengan-secret-otp-terpisah-minimal-32-karakter

# DEV_MODE hanya aktif jika true dan NODE_ENV bukan production.
# Tanpa provider pengiriman OTP, mode non-dev mengembalikan HTTP 503.
DEV_MODE=true

# Settlement: potongan platform (%) dari finalPrice ke wallet mitra
PLATFORM_FEE_PERCENT=10

PORT=3001
